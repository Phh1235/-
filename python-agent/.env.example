# ===== 运行方式 =====
# 1) 复制为 .env 后按需修改；所有值都有安全的默认值，不配也能跑（默认 mock 模式）
# 2) 密钥只允许放这里或系统环境变量，禁止写进代码 / 提交到 git（.env 已在 .gitignore）

# --- 服务 ---
AGENT_PORT=8000
# mock 模式：不访问外网，用确定性模拟数据，断网也能演示（默认开）
AGENT_MOCK_MODE=true
# 每个阶段的演示停顿，让前端 SSE 能看到进度推进（毫秒）
AGENT_STAGE_DELAY_MS=350

# --- 与 Java 的对接 ---
JAVA_BASE_URL=http://127.0.0.1:8080
# Java 回调地址（Java 侧配置的 app.agent.callback-url）
AGENT_CALLBACK_URL=http://127.0.0.1:8080/internal/agent/callback
# 与 Java 侧 app.agent.callback-secret 保持一致，用于 HMAC-SHA256 签名
AGENT_CALLBACK_SECRET=callback-secret-demo
# 与 Java 侧 app.agent.internal-token 保持一致，用于校验 /v1/** 请求来源
AGENT_INTERNAL_TOKEN=internal-token-demo

# --- 抓取安全 ---
# 工具域名白名单，逗号分隔；不在名单内的域名一律拒绝（含重定向目标）
FETCH_ALLOWED_DOMAINS=example.com,www.example.com,open.example.org
FETCH_TIMEOUT_SECONDS=8
FETCH_MAX_BYTES=524288
# 同一域名两次请求的最小间隔（秒），防止把对方站点打挂
FETCH_DOMAIN_MIN_INTERVAL=1.0
FETCH_MAX_PAGES=20

# --- 大模型（可选，OpenAI 兼容协议）---
# 默认可直接跑通：免密钥网关，免费额度约 1 次 / 45 秒
LLM_ENABLED=true
LLM_ALLOW_KEYLESS=true
LLM_BASE_URL=https://text.pollinations.ai/openai
LLM_MODEL=openai
LLM_TIMEOUT_SECONDS=40
# 调用失败后熔断多久（秒）；免费网关会返回 "Retry after Ns"，会按其提示缩短冷却
LLM_COOLDOWN_SECONDS=300
# 每个任务最多调用几次模型：免密钥网关只有 1 次/45 秒 → 填 1（规格+结论合并成一次）
# 有自己的 Key 时建议 3（PARSE 做规格归一化、REPORT 写结论，各占一次）
LLM_MAX_CALLS_PER_TASK=1

# 想换成自己的模型：填下面三行 + LLM_ALLOW_KEYLESS=false 即可（都是 OpenAI 兼容协议）
# DeepSeek     base_url=https://api.deepseek.com                      model=deepseek-chat
# 通义千问      base_url=https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# SiliconFlow  base_url=https://api.siliconflow.cn/v1                 model=Qwen/Qwen2.5-7B-Instruct
# 本地 Ollama   base_url=http://127.0.0.1:11434/v1                    model=qwen2.5:7b
# LLM_API_KEY=
